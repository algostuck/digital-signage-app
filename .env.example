# Copy to backend/.env for local development. Never commit real secrets.

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

DATABASE_URL=postgresql+asyncpg://signage:signage@localhost:5432/signage
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=signage-media
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_REGION=us-east-1
CDN_URL=
SIGNED_URL_TTL_SECONDS=900

CORS_ORIGINS=["http://localhost:5173"]
