# PRODUCTION — copy to deploy/env/prod.env on the deploy host, or feed the
# same names from the platform's secret manager. Never commit the copy.
# Managed PostgreSQL / Redis / object storage; no `selfhosted` profile:
#   docker compose -f deploy/compose.prod.yml --env-file deploy/env/prod.env up -d
DEPLOY_ENV=prod
ENVIRONMENT=production
LOG_LEVEL=INFO

# Pin images by digest or release tag in production, never `latest`.
BACKEND_IMAGE=ghcr.io/algostuck/digital-signage-app/backend:v1.0.0
FRONTEND_IMAGE=ghcr.io/algostuck/digital-signage-app/frontend:v1.0.0
WEB_PORT=8080            # a TLS terminator / load balancer sits in front
WEB_CONCURRENCY=4        # ~ CPU cores of the API host
WORKER_CONCURRENCY=4

DATABASE_URL=postgresql+asyncpg://signage:REPLACE@db.internal:5432/signage
REDIS_URL=rediss://REPLACE@redis.internal:6380/0

# >= 32 random characters (e.g. `openssl rand -base64 48`); rotating it signs
# everyone out and invalidates in-flight signed storage URLs (15 min)
JWT_SECRET=REPLACE
# Only for the very first `migrate` run; remove afterwards
SEED_PLATFORM_PASSWORD=

STORAGE_BACKEND=s3
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_BUCKET=signage-media-prod
S3_ACCESS_KEY=REPLACE
S3_SECRET_KEY=REPLACE
S3_REGION=ap-south-1
CDN_URL=https://media.signage.example.com
SIGNED_URL_TTL_SECONDS=900

CORS_ORIGINS=["https://signage.example.com"]
