# DEV — local development does not use the production compose file at all:
# `docker compose up --build` at the repository root (docker-compose.yml)
# or the native setup in README.md, with backend/.env copied from
# .env.example. This file documents the DEV column of the environment
# matrix in docs/deployment.md so the three environments can be compared
# side by side.
DEPLOY_ENV=dev
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
DATABASE_URL=postgresql+asyncpg://signage:signage@localhost:5432/digital_app_dev
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-only-secret-not-for-anything-else
STORAGE_BACKEND=local          # disk + self-signed URLs; no S3 needed
MEDIA_PROCESSING_INLINE=true   # no worker needed
PUBLISHING_INLINE=true
CORS_ORIGINS=["http://localhost:5173"]
SEED_DEMO=true                 # demo tenant + Indian demo dataset
