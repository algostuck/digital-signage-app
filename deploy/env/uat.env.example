# UAT — copy to deploy/env/uat.env (never commit the copy).
# Single box with self-hosted PostgreSQL / Redis / MinIO:
#   docker compose -f deploy/compose.prod.yml --env-file deploy/env/uat.env --profile selfhosted up -d
DEPLOY_ENV=uat
ENVIRONMENT=staging
LOG_LEVEL=INFO

BACKEND_IMAGE=ghcr.io/algostuck/digital-signage-app/backend:main
FRONTEND_IMAGE=ghcr.io/algostuck/digital-signage-app/frontend:main
WEB_PORT=80
WEB_CONCURRENCY=2
WORKER_CONCURRENCY=2

POSTGRES_USER=signage
POSTGRES_PASSWORD=change-me-uat
POSTGRES_DB=signage
DATABASE_URL=postgresql+asyncpg://signage:change-me-uat@postgres:5432/signage
REDIS_URL=redis://redis:6379/0

# >= 32 random characters; the API refuses to boot with a weak value in production
JWT_SECRET=change-me-to-a-long-random-string-for-uat
SEED_PLATFORM_PASSWORD=change-me-once-then-remove

STORAGE_BACKEND=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=signage-media
S3_ACCESS_KEY=signage
S3_SECRET_KEY=change-me-uat
S3_REGION=us-east-1
CDN_URL=

# The portal origin only. Behind the bundled nginx the portal and API are same-origin,
# so this is only needed if the API is exposed on another host name.
CORS_ORIGINS=["https://uat.signage.example.com"]
